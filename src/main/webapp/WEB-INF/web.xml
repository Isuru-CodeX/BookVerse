<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>BookVerse Online Library Portal</display-name>

  <!-- Context parameters: read in JSP through ${initParam.xxx} and in Java by the listener -->
  <context-param>
    <param-name>libraryName</param-name>
    <param-value>BookVerse Online Library Portal</param-value>
  </context-param>
  <context-param>
    <param-name>supportEmail</param-name>
    <param-value>help@bookverse.lk</param-value>
  </context-param>
  <context-param>
    <param-name>maxActiveLoans</param-name>
    <param-value>3</param-value>
  </context-param>

  <!-- Database (MySQL / MariaDB). Leave db.url EMPTY to run with in-memory demo data.
       Environment variables BOOKVERSE_DB_URL / _USER / _PASSWORD / _DRIVER override these values. -->
  <context-param>
    <param-name>db.driver</param-name>
    <param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>
  <context-param>
    <param-name>db.url</param-name>
    <param-value>jdbc:mysql://localhost:3306/bookverse?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Colombo&amp;useUnicode=true&amp;characterEncoding=UTF-8</param-value>
  </context-param>
  <context-param>
    <param-name>db.user</param-name>
    <param-value>root</param-value>
  </context-param>
  <context-param>
    <param-name>db.password</param-name>
    <param-value>I@suru2005110</param-value>
  </context-param>

  <!-- Listeners -->
  <listener><listener-class>com.bookverse.listener.AppContextListener</listener-class></listener>
  <listener><listener-class>com.bookverse.listener.SessionCountListener</listener-class></listener>

  <!-- Intercepting Filter chain (order = declaration order) -->
  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>com.bookverse.filter.EncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>LoggingFilter</filter-name>
    <filter-class>com.bookverse.filter.LoggingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.bookverse.filter.AuthFilter</filter-class>
  </filter>
  <filter-mapping><filter-name>EncodingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>LoggingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>*.do</url-pattern></filter-mapping>

  <!-- Front Controller -->
  <servlet>
    <servlet-name>FrontController</servlet-name>
    <servlet-class>com.bookverse.controller.FrontController</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>FrontController</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config><http-only>true</http-only></cookie-config>
  </session-config>

  <!-- JSP configuration: no scriptlets, UTF-8, taglibs pre-loaded in every page -->
  <jsp-config>
    <jsp-property-group>
      <display-name>All JSP pages</display-name>
      <url-pattern>*.jsp</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <scripting-invalid>true</scripting-invalid>
      <include-prelude>/WEB-INF/jspf/taglibs.jspf</include-prelude>
      <trim-directive-whitespaces>true</trim-directive-whitespaces>
      <default-content-type>text/html</default-content-type>
    </jsp-property-group>
  </jsp-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Declarative error handling -->
  <error-page><error-code>403</error-code><location>/error.jsp</location></error-page>
  <error-page><error-code>404</error-code><location>/error.jsp</location></error-page>
  <error-page><error-code>500</error-code><location>/error.jsp</location></error-page>
  <error-page><exception-type>java.lang.Throwable</exception-type><location>/error.jsp</location></error-page>
</web-app>
